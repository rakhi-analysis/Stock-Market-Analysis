      <column caption='7-Day Moving Average' datatype='real' name='[Calculation_36310273282756610]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG(SUM([Close]), -6, 0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
