      <column caption='Daily Return %' datatype='real' name='[Calculation_36310273284546563]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Close]) - LOOKUP(SUM([Close]), -1)) / LOOKUP(SUM([Close]), -1) * 100'>
